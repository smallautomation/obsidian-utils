import asyncio
import signal
import sys
from pathlib import Path

from obsidian.vault_watcher import ObsidianVaultWatcher
from sync.sync_manager import SyncManager
from telegram.notifications import TelegramNotifier
from utils.logger import setup_logger

logger = setup_logger(__name__)

class SyncService:
    def __init__(self, config_path: str = "config/config.yaml"):
        self.config_path = config_path
        self.is_running = False
        
    async def start(self):
        """Запуск основной службы синхронизации"""
        logger.info("Starting Obsidian Tracker Sync Service")
        
        # Инициализация компонентов
        self.notifier = TelegramNotifier(self.config_path)
        self.sync_manager = SyncManager(self.config_path)
        self.vault_watcher = ObsidianVaultWatcher(
            self.config_path,
            callback=self.on_vault_change
        )
        
        # Запуск
        await self.notifier.start()
        await self.sync_manager.start()
        self.vault_watcher.start()
        
        self.is_running = True
        logger.info("Service started successfully")
        
        # Главный цикл
        while self.is_running:
            await asyncio.sleep(1)
    
    def on_vault_change(self, file_path: Path):
        """Обработчик изменения файлов в vault"""
        logger.info(f"File changed: {file_path}")
        asyncio.create_task(self.sync_manager.sync_single_file(file_path))
    
    async def stop(self):
        """Остановка службы"""
        logger.info("Stopping service...")
        self.is_running = False
        self.vault_watcher.stop()
        await self.sync_manager.stop()
        await self.notifier.stop()

def main():
    service = SyncService()
    
    # Обработка сигналов
    def signal_handler(signum, frame):
        logger.info(f"Received signal {signum}")
        asyncio.create_task(service.stop())
    
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    try:
        asyncio.run(service.start())
    except KeyboardInterrupt:
        logger.info("Service stopped by user")
    except Exception as e:
        logger.error(f"Service failed: {e}", exc_info=True)
        sys.exit(1)

if __name__ == "__main__":
    main()